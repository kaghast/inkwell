# --- Required -------------------------------------------------------------
# Random secret; signs nothing public but encrypts stored Google refresh tokens.
# Changing it later disconnects every user's Google Calendar.  openssl rand -hex 32
SECRET_KEY=

# Public URL users open in the browser (no trailing slash).
APP_URL=https://notes.example.com

# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web application)
# Authorized redirect URI: ${APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Optional -------------------------------------------------------------
DB_NAME=inkwell
MONGO_URL=mongodb://mongo:27017
FRONTEND_PORT=3000

# Only when backend runs on a different domain than the frontend:
# REACT_APP_BACKEND_URL=https://api.example.com
# OAUTH_REDIRECT_URI=https://api.example.com/api/auth/google/callback
# CORS_ORIGINS=https://notes.example.com
# COOKIE_SAMESITE=none
